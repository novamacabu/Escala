function generatePrintReport(lineId,driverName,month){
  const targetLines=lineId==='ALL'?lines:lines.filter(l=>l.id===lineId);
  const targetDriver=driverName==='ALL'?null:driverName;
  const dim=new Date(currentYear,month+1,0).getDate();
  const css=`body{font-family:'Georgia','Times New Roman',serif;font-size:11px;color:#111;padding:20px;}h1{font-size:22px;color:#9a6800;margin-bottom:4px;}h2{font-size:14px;color:#555;border-bottom:2px solid #9a6800;padding-bottom:4px;margin:20px 0 8px;}.subtitle{color:#888;font-size:11px;margin-bottom:16px;}table{width:100%;border-collapse:collapse;margin-bottom:14px;font-size:10px;page-break-inside:avoid;}th{background:#f5f0e8;text-align:left;padding:5px 8px;border:1px solid #ccc;font-weight:700;}td{padding:5px 8px;border:1px solid #ddd;}.day-col{width:55px;background:#fafafa;font-weight:700;}.dom{color:#c0392b;}.sab{color:#1a4a7a;}.hol{background:#fff8e8!important;}.driver-cell{font-weight:700;}.empty-cell{color:#bbb;font-style:italic;}.status-FALTA{background:#fff0f0;color:#c0392b;font-weight:700;}.status-ATESTADO{background:#fdf0fa;}.status-FOLGA{background:#f0f8ff;}.status-EXTRA{background:#fffbe6;color:#9a6800;font-weight:700;}.totals{margin-top:8px;font-size:11px;background:#f5f0e8;padding:10px;border-radius:6px;}@media print{@page{size:A4 portrait;margin:10mm;}button{display:none!important;}*{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;}}`;
  let html=`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Escala ${MONTHS_PT[month]} ${currentYear}</title><style>${css}</style></head><body>`;
  html+=`<h1>🚌 Escala de Motoristas — Transportadora Macabu</h1>`;
  html+=`<div class="subtitle">${MONTHS_PT[month]} de ${currentYear} ${targetDriver?'· Motorista: <b>'+targetDriver+'</b>':''} · Gerado em ${new Date().toLocaleString('pt-BR')}</div>`;
  targetLines.forEach(line=>{
    html+=`<h2>Linha ${line.num} — ${line.desc}</h2>`;
    // Build table: rows = days, cols = times of the day type
    const allTimes=Array.from(new Set([...line.schedule.weekday,...line.schedule.saturday,...line.schedule.sunday])).sort();
    html+='<table><thead><tr><th class="day-col">Dia</th>';
    allTimes.forEach(t=>{html+=`<th>${t}</th>`;});
    html+='</tr></thead><tbody>';
    const driverCounts={};
    for(let d=1;d<=dim;d++){
      const dow=new Date(currentYear,month,d).getDay();
      const dayTimes=getTimesForDay(line,dow);
      const dayName=DAYS_PT[dow];
      const hol=getHoliday(month,d);
      const cls=dow===0?'dom':(dow===6?'sab':'');
      const holClass=hol?' hol':'';
      html+=`<tr class="${holClass}"><td class="day-col ${cls}">${d}/${String(month+1).padStart(2,'0')}<br><span style="font-size:9px;font-weight:400;">${dayName}</span>${hol?'<br><span style="font-size:7px;color:#c0392b;">'+hol+'</span>':''}</td>`;
      allTimes.forEach(t=>{
        if(!dayTimes.includes(t)){html+='<td style="background:#fafafa;"></td>';return;}
        const key=slotKey(line.id,currentYear,month,d,t);
        const slot=schedule[key];
        if(!slot){html+='<td class="empty-cell">—</td>';return;}
        if(targetDriver&&slot.driver!==targetDriver){html+='<td style="opacity:.25;">'+slot.driver.split(' ')[0]+'</td>';return;}
        driverCounts[slot.driver]=(driverCounts[slot.driver]||{total:0,extra:0,falta:0});
        driverCounts[slot.driver].total++;
        if(slot.status==='EXTRA')driverCounts[slot.driver].extra++;
        if(slot.status==='FALTA')driverCounts[slot.driver].falta++;
        const statusCls=slot.status!=='OK'?' status-'+slot.status:'';
        const tag=slot.status==='EXTRA'?' ⏰':slot.status==='FALTA'?' ✗':slot.status==='ATESTADO'?' 🏥':slot.status==='FOLGA'?' ☕':'';
        html+=`<td class="driver-cell${statusCls}">${slot.driver}${tag}</td>`;
      });
      html+='</tr>';
    }
    html+='</tbody></table>';
    // Totals (admin only — show counts)
    if(!targetDriver&&Object.keys(driverCounts).length){
      html+='<div class="totals"><b>Totais do mês:</b><br>';
      Object.keys(driverCounts).sort().forEach(name=>{
        const c=driverCounts[name];
        html+=`<div style="display:inline-block;margin:4px 12px 4px 0;"><b>${name}:</b> ${c.total} turno(s)`;
        if(c.extra)html+=` · <span style="color:#9a6800;">${c.extra} hora(s) extra</span>`;
        if(c.falta)html+=` · <span style="color:#c0392b;">${c.falta} falta(s)</span>`;
        html+='</div>';
      });
      html+='</div>';
    }
  });
  html+='<br><div style="margin-top:20px;display:flex;gap:12px;"><button onclick="window.print()" style="padding:12px 28px;background:#9a6800;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;">🖨️ Imprimir / Salvar PDF</button></div>';
  html+='</body></html>';
  const w=window.open('about:blank','_blank');
  if(w){w.document.open();w.document.write(html);w.document.close();}
}

// ============ DRAG & DROP ============
let dragging=null,lastOver=null;
const ghost=document.getElementById('ghost');
let wasDragging=false;
function setupSlotInteraction(el,slotK,time,d){
  // Tap to edit
  let tapStart=0,moved=false,sx=0,sy=0,touchId=null;
  el.addEventListener('touchstart',e=>{if(e.touches.length>1)return;tapStart=Date.now();moved=false;sx=e.touches[0].clientX;sy=e.touches[0].clientY;touchId=e.touches[0].identifier;
    function tm(ev){let t;for(let x of ev.changedTouches)if(x.identifier===touchId){t=x;break;}if(!t)return;const dx=Math.abs(t.clientX-sx),dy=Math.abs(t.clientY-sy);if(!moved&&(dx>10||dy>10)&&schedule[slotK]){moved=true;ev.preventDefault();startDrag(el,slotK,sx,sy);}if(moved){ev.preventDefault();moveGhost(t.clientX,t.clientY);handleDragOver(t.clientX,t.clientY);}}
    function tu(ev){let t;for(let x of ev.changedTouches)if(x.identifier===touchId){t=x;break;}document.removeEventListener('touchmove',tm);document.removeEventListener('touchend',tu);if(moved&&t){endDrag(t.clientX,t.clientY);}else{ghost.style.display='none';if(dragging){dragging.el.classList.remove('dragging');dragging=null;}if(!moved&&Date.now()-tapStart<350){openSlotEdit(slotK,time,d);}}}
    document.addEventListener('touchmove',tm,{passive:false});document.addEventListener('touchend',tu);
  },{passive:true});
  el.addEventListener('mousedown',e=>{if(e.button!==0)return;let moved=false;const sx=e.clientX,sy=e.clientY;
    function mm(ev){if(!moved&&(Math.abs(ev.clientX-sx)>6||Math.abs(ev.clientY-sy)>6)&&schedule[slotK]){moved=true;wasDragging=true;startDrag(el,slotK,sx,sy);}if(moved){moveGhost(ev.clientX,ev.clientY);handleDragOver(ev.clientX,ev.clientY);}}
    function mu(ev){document.removeEventListener('mousemove',mm);document.removeEventListener('mouseup',mu);if(moved){endDrag(ev.clientX,ev.clientY);}else{ghost.style.display='none';if(dragging){dragging.el.classList.remove('dragging');dragging=null;}}}
    document.addEventListener('mousemove',mm);document.addEventListener('mouseup',mu);
  });
  el.addEventListener('click',e=>{if(!wasDragging){e.stopPropagation();openSlotEdit(slotK,time,d);}wasDragging=false;});
}
function startDrag(el,slotK,cx,cy){
  const slot=schedule[slotK];if(!slot)return;dragging={el,slotK};setTimeout(()=>el.classList.add('dragging'),60);
  const drv=getDriver(slot.driver);
  ghost.textContent=slot.driver;ghost.style.color=drv.color;ghost.style.display='block';
  moveGhost(cx,cy);
}
function moveGhost(x,y){ghost.style.left=(x-ghost.offsetWidth/2)+'px';ghost.style.top=(y-ghost.offsetHeight/2-14)+'px';}
function handleDragOver(x,y){
  const un=document.elementFromPoint(x,y);const cell=un?un.closest('.time-row[data-slot-key]'):null;
  if(lastOver&&lastOver!==cell)lastOver.classList.remove('drag-over');
  if(cell&&cell.dataset.slotKey!==dragging.slotK){cell.style.background='rgba(212,168,67,.2)';lastOver=cell;}else lastOver=null;
}
function endDrag(cx,cy){
  if(!dragging)return;ghost.style.display='none';dragging.el.classList.remove('dragging');
  const un=document.elementFromPoint(cx,cy);const target=un?un.closest('.time-row[data-slot-key]'):null;
  if(lastOver){lastOver.style.background='';lastOver=null;}
  if(target&&target.dataset.slotKey!==dragging.slotK){
    const fromK=dragging.slotK,toK=target.dataset.slotKey;
    const moved=schedule[fromK];
    if(confirm(`Mover ${moved.driver} para este horário?`)){
      // If target already has someone, swap
      const existing=schedule[toK];
      delete schedule[fromK];
      schedule[toK]=moved;
      if(existing)schedule[fromK]=existing;
      markDirty();renderAll();showToast(existing?'Trocados':'Movido');
    }else{renderAll();}
    wasDragging=true;
  }else{renderAll();}
  dragging=null;
}

