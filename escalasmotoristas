<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Escala de Motoristas — Transportadora Macabu</title>
<style>
:root{--bg:#0b0b10;--surface:#13131c;--card:#1a1a28;--border:#252535;--border2:#32324a;--text:#e8e4f0;--muted:#5a576e;--accent:#d4a843;--ok:#2e7d52;--warn:#8b2020;--ok-light:#4caf7d;--warn-light:#e05555;--info:#4a7aaa;--info-light:#7aa5d4;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--bg);color:var(--text);font-family:'Georgia Pro','Georgia',serif;min-height:100vh;overflow-x:hidden;-webkit-tap-highlight-color:transparent;touch-action:pan-y;transition:background .2s,color .2s;}
body.light{--bg:#ffffff;--surface:#f2f2f2;--card:#ffffff;--border:#d0d0d0;--border2:#a0a0a0;--text:#111111;--muted:#555555;--accent:#9a6800;--ok:#1a6b3a;--warn:#8b0000;--ok-light:#1e8449;--warn-light:#c0392b;--info:#1a4a7a;--info-light:#3a7ac4;}
body.light .sync-banner{background:#f0f0f0;color:#333;border-bottom:1px solid #d0d0d0;}
body.light .top-bar{background:#fff;}
body.light .cloud-badge{background:rgba(154,104,0,.08);border-color:rgba(154,104,0,.25);color:#9a6800;}
body.light .tbtn{background:#f2f2f2;border-color:#d0d0d0;color:#333;}
body.light .hdr{background:#fff;border-bottom:1px solid #d0d0d0;}
body.light .line-title{color:#9a6800!important;}
body.light .yr{color:#555!important;}
body.light .leg-bar{background:#fff;border-bottom:1px solid #d0d0d0;}
body.light .leg{color:#111;}
body.light .hint{color:#888;background:#fff;}
body.light .cal-wrap{background:#fff;}
body.light .month-block{background:#fff;}
body.light .filter-bar{background:#fff;border-bottom:1px solid #d0d0d0;}
body.light .line-tabs{background:#fff;border-bottom:1px solid #d0d0d0;}
body.light .cell{background:#fff!important;border-color:#e0e0e0!important;}
body.light .cell.empty{background:#f5f5f5!important;}
body.light .cell.today{background:#fffbef!important;border-color:var(--accent)!important;}
body.light .cell.weekend{background:#fafafa!important;}
body.light .day-hdr{background:#f0f0f0!important;color:#555!important;}
body.light .day-hdr.dom{color:#c0392b!important;}
body.light .day-num{color:#333!important;}
body.light .day-dow{color:#666!important;}
body.light .htag{color:#c0392b;background:rgba(192,57,43,.08);}
body.light .add-btn{color:#aaa;border-color:#ccc;}
body.light .time-row{background:#fafafa;border-color:#e8e8e8;}
body.light .time-tag{background:#f0ede4;color:#9a6800;}
body.light .shift-divider{background:#d0d0d0;}
body.light::after{display:none;}
body::after{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");pointer-events:none;z-index:9000;}
.sync-banner{display:flex;align-items:center;gap:8px;padding:8px 18px;font-size:9px;letter-spacing:1.5px;color:var(--muted);text-transform:uppercase;border-bottom:1px solid var(--border);}
.sync-banner .sb-dot{width:6px;height:6px;border-radius:50%;background:var(--muted);flex-shrink:0;transition:background .3s;}
.sync-banner.synced .sb-dot{background:var(--ok-light);box-shadow:0 0 6px var(--ok-light);}
.sync-banner.syncing .sb-dot{background:var(--accent);box-shadow:0 0 6px var(--accent);animation:pulse 1s infinite;}
.sync-banner.error .sb-dot{background:var(--warn-light);}
.sync-banner.synced{color:var(--ok-light);}
.sync-banner.syncing{color:var(--accent);}
.sync-banner.error{color:var(--warn-light);}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.top-bar{display:flex;align-items:center;justify-content:space-between;padding:14px 18px 0;gap:8px;flex-wrap:wrap;}
.top-bar-right{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end;}
.tbtn{display:flex;align-items:center;gap:5px;font-family:'Georgia Pro','Georgia',serif;font-size:10px;letter-spacing:.8px;padding:7px 12px;border-radius:20px;cursor:pointer;transition:background .15s;user-select:none;border:1px solid;}
.tbtn-cfg{background:rgba(212,168,67,.08);border-color:rgba(212,168,67,.22);color:var(--accent);}
.tbtn-theme{background:var(--surface);border-color:var(--border);color:var(--muted);}
.tbtn-line{background:rgba(122,165,212,.1);border-color:rgba(122,165,212,.3);color:var(--info-light);}
.tbtn-share{background:rgba(139,114,245,.12);border-color:rgba(139,114,245,.3);color:#a99ef5;}
.cloud-badge{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--accent);background:rgba(212,168,67,.08);border:1px solid rgba(212,168,67,.2);border-radius:20px;padding:5px 12px;font-weight:700;}
.line-tabs{display:flex;gap:6px;padding:12px 18px;border-bottom:1px solid var(--border);overflow-x:auto;align-items:center;}
.line-tab{display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 16px;border-radius:14px;background:var(--card);border:2px solid var(--border);cursor:pointer;transition:all .15s;user-select:none;min-width:88px;font-family:'Georgia Pro','Georgia',serif;flex-shrink:0;}
.line-tab.active{background:var(--accent);border-color:var(--accent);color:#0b0b10;box-shadow:0 4px 12px rgba(212,168,67,.25);}
.line-tab .lt-num{font-size:16px;font-weight:800;letter-spacing:-.5px;}
.line-tab .lt-desc{font-size:8px;letter-spacing:1px;text-transform:uppercase;opacity:.85;}
.line-tab.active .lt-desc{opacity:1;}
.line-tab-add{background:transparent;border:2px dashed var(--border2);color:var(--muted);min-width:48px;justify-content:center;}
.line-tab-add:hover{color:var(--accent);border-color:var(--accent);}
.filter-bar{display:flex;flex-wrap:wrap;gap:6px;padding:10px 18px;border-bottom:1px solid var(--border);align-items:center;}
.filter-bar-label{font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);}
.filter-chip{display:flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;font-size:10px;font-family:'Georgia Pro','Georgia',serif;font-weight:700;cursor:pointer;border:1.5px solid transparent;transition:all .15s;user-select:none;opacity:.5;}
.filter-chip.active{opacity:1;}
.hdr{padding:10px 18px 16px;display:flex;align-items:flex-end;gap:12px;border-bottom:1px solid var(--border);flex-wrap:wrap;}
.line-title{font-family:'Georgia Pro','Georgia',serif;font-size:clamp(28px,7vw,52px);font-weight:800;color:var(--accent);letter-spacing:-1.5px;line-height:1;}
.line-subtitle{font-size:11px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding-bottom:6px;}
.month-nav{display:flex;align-items:center;gap:10px;margin-left:auto;padding-bottom:4px;}
.month-nav button{background:var(--card);border:1px solid var(--border);color:var(--text);padding:6px 14px;border-radius:20px;font-family:'Georgia Pro','Georgia',serif;font-size:11px;font-weight:700;cursor:pointer;}
.month-nav .mn-label{font-size:13px;font-weight:800;color:var(--accent);min-width:130px;text-align:center;}
.leg-bar{display:flex;flex-wrap:wrap;gap:8px 14px;padding:10px 18px;border-bottom:1px solid var(--border)}
.leg{display:flex;align-items:center;gap:5px;font-size:10px;letter-spacing:1px;text-transform:uppercase}
.hint{text-align:center;font-size:9px;letter-spacing:2px;color:var(--muted);padding:7px;text-transform:uppercase}
.cal-wrap{padding:0 8px 8px;overflow-x:auto}
.calendar{display:grid;grid-template-columns:repeat(7,minmax(126px,1fr));gap:3px;min-width:760px}
.day-hdr{background:var(--surface);text-align:center;padding:9px 4px;font-size:10px;letter-spacing:3px;color:var(--muted);text-transform:uppercase;font-weight:700;}
.day-hdr.dom{color:#e57272;}
.cell{background:var(--card);min-height:160px;padding:8px 7px 6px;display:flex;flex-direction:column;gap:3px;position:relative;border:1.5px solid transparent;transition:background .15s,border-color .15s;}
.cell.empty{background:var(--surface);opacity:.22;pointer-events:none;}
.cell.today{background:#14142a;border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent);}
.cell.weekend{background:#15151f;}
.cell.dom .day-num{color:#e57272;}
.cell.today .day-num{color:var(--accent);}
.cell.drag-over{background:#1c1c38;box-shadow:inset 0 0 0 2px rgba(212,168,67,.4);}
.day-num{font-family:'Georgia Pro','Georgia',serif;font-size:20px;font-weight:800;color:var(--muted);line-height:1;pointer-events:none;}
.day-dow{font-size:9px;color:var(--muted);opacity:.55;letter-spacing:.5px;pointer-events:none;text-transform:uppercase;margin-top:1px;margin-bottom:4px;}
.cell.dom .day-dow{color:#e57272;opacity:.75;}
.htag{font-size:8px;letter-spacing:.8px;text-transform:uppercase;color:#e57272;background:rgba(229,114,114,.1);border-radius:3px;padding:2px 5px;pointer-events:none;display:inline-block;align-self:flex-start;}
.time-row{display:flex;align-items:center;gap:5px;padding:4px 6px;border-radius:7px;background:rgba(255,255,255,.03);border:1px solid var(--border);cursor:pointer;transition:background .15s;user-select:none;touch-action:none;}
.time-row:hover{background:rgba(255,255,255,.06);}
.time-row.dragging{opacity:.4;}
.time-row.dimmed{opacity:.18;}
.time-row.empty-slot{border-style:dashed;opacity:.55;}
.time-row.empty-slot:hover{opacity:1;border-color:var(--accent);}
.time-tag{font-size:9px;font-family:'Georgia Pro','Georgia',serif;font-weight:800;color:var(--accent);background:rgba(212,168,67,.1);padding:2px 5px;border-radius:4px;flex-shrink:0;min-width:34px;text-align:center;letter-spacing:-.3px;}
.driver-chip{display:flex;align-items:center;gap:4px;flex:1;min-width:0;font-size:10px;font-weight:700;font-family:'Georgia Pro','Georgia',serif;}
.driver-chip .av{width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;flex-shrink:0;border:1.5px solid rgba(255,255,255,.3);overflow:hidden;}
.driver-chip .av img{width:100%;height:100%;object-fit:cover;}
.driver-chip .nm{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;}
.empty-slot .driver-chip{color:var(--muted);font-style:italic;opacity:.7;}
.status-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.status-OK{background:var(--ok-light);box-shadow:0 0 4px var(--ok-light);}
.status-FALTA{background:var(--warn-light);box-shadow:0 0 4px var(--warn-light);}
.status-ATESTADO{background:#f0a0d0;}
.status-FOLGA{background:#80c8f0;}
.status-EXTRA{background:#fbbf24;box-shadow:0 0 4px #fbbf24;}
.add-btn{margin-top:auto;font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--border2);border:1px dashed var(--border2);border-radius:20px;padding:3px 0;text-align:center;cursor:pointer;transition:color .2s;user-select:none}
.add-btn:hover{color:var(--accent);border-color:var(--accent)}
.comment-bubble{display:flex;align-items:flex-start;gap:5px;background:rgba(212,168,67,.07);border:1px solid rgba(212,168,67,.18);border-radius:8px;padding:4px 6px;margin-top:1px;cursor:pointer;}
.comment-bubble .cb-icon{font-size:9px;flex-shrink:0;opacity:.7;}
.comment-bubble .cb-text{font-size:9px;color:rgba(232,228,240,.7);line-height:1.4;word-break:break-word;flex:1;}
#ghost{position:fixed;pointer-events:none;z-index:9500;display:none;opacity:.9;transform:scale(1.05);box-shadow:0 16px 48px rgba(0,0,0,.55);border-radius:8px;padding:5px 10px;font-family:'Georgia Pro','Georgia',serif;font-size:11px;font-weight:700;white-space:nowrap;background:#0b0b10;border:1px solid var(--accent);}
.overlay{position:fixed;inset:0;z-index:8000;background:rgba(0,0,0,.72);display:flex;align-items:flex-end;justify-content:center;opacity:0;pointer-events:none;transition:opacity .22s}
.overlay.open{opacity:1;pointer-events:all}
.sheet{background:#16162a;border-radius:20px 20px 0 0;width:100%;max-width:560px;padding:20px 20px 36px;transform:translateY(100%);transition:transform .28s cubic-bezier(.32,1,.4,1);border-top:1px solid var(--border2);max-height:90vh;overflow-y:auto;}
body.light .sheet{background:#f0ede4;}
.overlay.open .sheet{transform:translateY(0)}
.sheet-handle{width:36px;height:4px;border-radius:2px;background:var(--border2);margin:0 auto 18px}
.sheet-title{font-family:'Georgia Pro','Georgia',serif;font-size:16px;font-weight:700;color:var(--accent);margin-bottom:16px;}
.sheet-day-label{font-size:10px;color:var(--muted);letter-spacing:2px;text-transform:uppercase;margin-bottom:4px}
.action-list{display:flex;flex-direction:column;gap:8px}
.action-btn{display:flex;align-items:center;gap:10px;padding:13px 14px;border-radius:12px;background:var(--card);border:1px solid var(--border);color:var(--text);font-family:'Georgia Pro','Georgia',serif;font-size:12px;cursor:pointer;transition:background .15s;user-select:none}
.action-btn:hover{background:#20203a;}
.action-btn .ico{font-size:16px;width:24px;text-align:center}
.action-btn.danger{color:#f57272}
.action-btn.success{color:var(--ok-light)}
.action-btn.warn{color:var(--warn-light)}
.action-btn.wa{color:#25d366}
.form-group{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
.form-label{font-size:10px;color:var(--muted);letter-spacing:2px;text-transform:uppercase}
.driver-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.driver-opt{padding:10px 8px;border-radius:10px;text-align:center;background:var(--card);border:1.5px solid var(--border);font-family:'Georgia Pro','Georgia',serif;font-size:13px;font-weight:700;cursor:pointer;transition:background .15s;user-select:none;}
.status-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.status-opt{padding:10px 8px;border-radius:10px;text-align:center;background:var(--card);border:1.5px solid var(--border);font-family:'Georgia Pro','Georgia',serif;font-size:12px;font-weight:700;cursor:pointer;transition:background .15s;user-select:none;display:flex;align-items:center;justify-content:center;gap:6px}
.status-opt.sel{filter:brightness(1.2);}
.confirm-btn{width:100%;padding:14px;border-radius:12px;background:var(--accent);color:#0b0b10;font-family:'Georgia Pro','Georgia',serif;font-size:14px;font-weight:800;border:none;cursor:pointer;margin-top:6px;transition:opacity .15s;}
.confirm-btn:hover{opacity:.88}
.confirm-btn:disabled{opacity:.35;cursor:not-allowed}
.cancel-btn{width:100%;padding:12px;border-radius:12px;background:transparent;color:var(--muted);font-family:'Georgia Pro','Georgia',serif;font-size:13px;font-weight:700;border:1px solid var(--border);cursor:pointer;margin-top:8px;}
.text-input{width:100%;padding:12px 14px;border-radius:10px;background:var(--card);border:1.5px solid var(--border2);color:var(--text);font-family:'Georgia Pro','Georgia',serif;font-size:14px;font-weight:700;outline:none;transition:border-color .15s;}
.text-input:focus{border-color:var(--accent);}
.color-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:4px;}
.color-swatch{width:100%;aspect-ratio:1;border-radius:50%;cursor:pointer;border:3px solid transparent;transition:border-color .15s,transform .15s;}
.color-swatch.sel{border-color:#fff;transform:scale(1.15);}
.people-list{display:flex;flex-direction:column;gap:8px;}
.person-row{display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:12px;background:var(--card);border:1px solid var(--border);}
.person-row .pr-av{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:#0b0b10;flex-shrink:0;}
.person-row .pr-ico{font-size:18px;cursor:pointer;padding:4px;color:var(--muted);transition:color .15s;}
.person-row .pr-ico:hover{color:var(--accent);}
#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--border2);color:var(--text);padding:9px 18px;border-radius:30px;font-size:11px;z-index:9800;transition:transform .3s ease;pointer-events:none;border:1px solid var(--border);white-space:nowrap}
#toast.show{transform:translateX(-50%) translateY(0)}
footer{text-align:center;font-size:9px;letter-spacing:2px;color:var(--muted);padding:10px 10px 20px;text-transform:uppercase;opacity:.4}
.line-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:20px;font-size:10px;font-weight:800;letter-spacing:.5px;}
.times-list{display:flex;flex-direction:column;gap:6px;max-height:280px;overflow-y:auto;padding:4px;background:var(--card);border-radius:10px;border:1px solid var(--border);}
.time-edit-row{display:flex;align-items:center;gap:8px;padding:6px;}
.time-edit-row input{flex:1;background:var(--bg);border:1px solid var(--border);color:var(--text);padding:6px 10px;border-radius:6px;font-family:'Georgia Pro','Georgia',serif;font-size:12px;}
.time-edit-row .del{cursor:pointer;color:var(--warn-light);font-size:14px;padding:2px 6px;}
@media print{
@page{size:A4 landscape;margin:8mm;}
html,body{background:#fff!important;color:#111!important;font-size:7px;}
body::after{display:none;}
.top-bar,.hint,.overlay,#ghost,#toast,footer,.add-btn,.tbtn,.sync-banner,.cloud-badge,.filter-bar,.line-tabs,.month-nav{display:none!important;}
.hdr{padding:4px 8px;border-bottom:1px solid #ccc;}
.line-title{font-size:22px!important;color:#9a6800!important;}
.cal-wrap{overflow:visible;}
.calendar{min-width:unset;gap:1px;grid-template-columns:repeat(7,1fr);}
.day-hdr{background:#f0f0f0!important;color:#555!important;padding:3px 2px;font-size:7px;}
.cell{background:#fafafa!important;min-height:78px;padding:3px;gap:1px;border:1px solid #ddd!important;}
.cell.today{background:#fffbef!important;}
.cell.empty{background:#f5f5f5!important;opacity:.4;}
.day-num{font-size:10px!important;color:#aaa!important;}
.day-dow{font-size:6px!important;}
.time-row{padding:1px 3px;font-size:7px;border:1px solid #ddd;}
.time-tag{font-size:6px;padding:1px 3px;}
.driver-chip{font-size:7px;}
.driver-chip .av{width:11px;height:11px;font-size:5px;}
.status-dot{width:6px;height:6px;}
}
</style>
</head>
<body>
<div class="sync-banner syncing" id="sync-banner">
  <span class="sb-dot"></span>
  <span id="sync-text">Carregando...</span>
  <span style="margin-left:auto;opacity:.5;font-size:8px">☁ PILOTO</span>
</div>
<div class="top-bar">
  <div class="cloud-badge">🚌 Escala Motoristas · Transportadora Macabu</div>
  <div class="top-bar-right" id="top-bar-right">
    <button class="tbtn tbtn-theme" onclick="toggleTheme()" id="theme-btn">📴</button>
    <button class="tbtn tbtn-line" onclick="openLineConfig()" id="btn-lines">🚍 Linhas</button>
    <button class="tbtn tbtn-cfg" onclick="openDriversConfig()" id="btn-drivers">👤 Motoristas</button>
    <button class="tbtn" style="background:rgba(37,211,102,.1);border-color:rgba(37,211,102,.3);color:#25d366;" onclick="openPrintSheet()">🖨️ Imprimir</button>
    <button class="tbtn tbtn-share" onclick="shareLink()" id="btn-share">🔗 Compartilhar</button>
    <button class="tbtn" onclick="logoutAdmin()" style="background:rgba(229,114,114,.1);border-color:rgba(229,114,114,.3);color:#e57272;" id="btn-logout">🚪 Sair</button>
  </div>
</div>
<div class="line-tabs" id="line-tabs"></div>
<div class="filter-bar" id="filter-bar"></div>
<div id="calendar-host"></div>
<div class="overlay" id="overlay"><div class="sheet"><div class="sheet-handle"></div><div class="sheet-day-label" id="sheet-day-label"></div><div class="sheet-title" id="sheet-title"></div><div id="sheet-body"></div></div></div>
<div id="ghost"></div><div id="toast"></div>
<footer>Piloto · Escala de Motoristas · Transportadora Macabu</footer>
<script>
// ============ CONFIG ============
const ADMIN_PASS='macabu2026';
const ASSIST_PASS='escala2026';
const params=new URLSearchParams(window.location.search);
// Determine role: 'admin' | 'assist' | 'view'
function detectRole(){
  if(params.get('admin')===ADMIN_PASS||sessionStorage.getItem('escala_role')==='admin')return 'admin';
  if(params.get('assist')===ASSIST_PASS||sessionStorage.getItem('escala_role')==='assist')return 'assist';
  return 'view';
}
let ROLE=detectRole();
let READ_ONLY=ROLE==='view';
let IS_ADMIN=ROLE==='admin';
let IS_ASSIST=ROLE==='assist';
const DAYS_PT=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
const MONTHS_PT=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const PRESET_COLORS=['#e8c97a','#72e5a8','#a99ef5','#f5a87c','#f0a0d0','#80c8f0','#f87171','#60a5fa','#34d399','#fbbf24','#e879f9','#fb923c','#a78bfa','#22d3ee','#facc15','#f43f5e'];

// ============ DATA ============
// LINHAS — baseadas nos horários reais que encontrei nos chats anteriores
let lines=[
