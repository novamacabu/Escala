// HOLIDAYS (Brasil + locais Macaé/Macabu — exemplos)
const HOLIDAYS={
  '01-01':'Confraternização','04-21':'Tiradentes','05-01':'Trabalho',
  '09-07':'Independência','10-12':'N.Sra.Aparecida','11-02':'Finados',
  '11-15':'República','12-25':'Natal','06-13':'Sto. Antonio'
};

let currentLine='1000';
let currentMonth=new Date().getMonth();
let currentYear=new Date().getFullYear();
let activeFilter='TODOS';
let isDirty=false;

function setSyncStatus(s,t){
  const b=document.getElementById('sync-banner');
  b.className='sync-banner '+s;
  document.getElementById('sync-text').textContent=t;
}

// ============ HELPERS ============
function getDriver(n){return drivers.find(d=>d.name===n)||{name:n,color:'#aaa',phone:'',photo:''};}
function getLine(id){return lines.find(l=>l.id===id);}
function dayKey(y,m,d){return `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;}
function slotKey(lineId,y,m,d,time){return `${lineId}|${dayKey(y,m,d)}|${time}`;}
function getHoliday(m,d){return HOLIDAYS[`${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`];}
function escHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

function getTimesForDay(line,dow){
  // dow: 0=Dom, 6=Sáb
  if(dow===0)return line.schedule.sunday||[];
  if(dow===6)return line.schedule.saturday||[];
  return line.schedule.weekday||[];
}

function statusLabel(s){
  return {OK:'✓ Escalado',FALTA:'✗ Falta',ATESTADO:'🏥 Atestado',FOLGA:'☕ Folga',EXTRA:'⏰ Hora Extra'}[s]||'—';
}
function statusEmoji(s){return {OK:'',FALTA:'✗',ATESTADO:'🏥',FOLGA:'☕',EXTRA:'⏰'}[s]||'';}

// ============ RENDER ============
function buildLineTabs(){
  const wrap=document.getElementById('line-tabs');wrap.innerHTML='';
  lines.forEach(line=>{
    const tab=document.createElement('div');
    tab.className='line-tab'+(line.id===currentLine?' active':'');
    if(line.id!==currentLine)tab.style.borderColor=line.color+'88';
    tab.innerHTML=`<div class="lt-num">${line.num}</div><div class="lt-desc">${line.desc}</div>`;
    tab.onclick=()=>{currentLine=line.id;renderAll();};
    wrap.appendChild(tab);
  });
  if(!READ_ONLY){
    const add=document.createElement('div');add.className='line-tab line-tab-add';
    add.innerHTML='<div style="font-size:22px;line-height:1;">+</div><div class="lt-desc">Linha</div>';
    add.onclick=()=>openAddLine();
    wrap.appendChild(add);
  }
}

function buildFilterBar(){
  const fb=document.getElementById('filter-bar');
  if(READ_ONLY){fb.style.display='none';return;}
  fb.style.display='';fb.innerHTML='<span class="filter-bar-label">Filtrar:</span>';
  const all=document.createElement('div');
  all.className='filter-chip'+(activeFilter==='TODOS'?' active':'');
  all.style.cssText='background:rgba(212,168,67,.1);border-color:rgba(212,168,67,.3);color:var(--accent);';
  all.textContent='Todos';all.onclick=()=>{activeFilter='TODOS';renderAll();};
  fb.appendChild(all);
  drivers.forEach(d=>{
    const c=document.createElement('div');
    c.className='filter-chip'+(activeFilter===d.name?' active':'');
    c.style.cssText=`background:${d.color}18;border-color:${d.color}55;color:${d.color};`;
    c.innerHTML=`<span style="width:7px;height:7px;border-radius:50%;background:${d.color};display:inline-block;"></span>${d.name}`;
    c.onclick=()=>{activeFilter=d.name;renderAll();};
    fb.appendChild(c);
  });
}

function renderAll(){
  try{
    buildLineTabs();
    buildFilterBar();
    const line=getLine(currentLine);if(!line)return;
    const host=document.getElementById('calendar-host');
    const legend=drivers.map(d=>{
      const av=d.photo?`<span style="width:16px;height:16px;border-radius:50%;overflow:hidden;display:inline-flex;flex-shrink:0;border:1.5px solid ${d.color};"><img src="${d.photo}" style="width:100%;height:100%;object-fit:cover;"></span>`:`<span style="width:11px;height:11px;border-radius:50%;background:${d.color};display:inline-flex;flex-shrink:0;"></span>`;
      return `<div class="leg">${av}${d.name}</div>`;
    }).join('');
    const statusLeg=READ_ONLY?'':`<div class="leg" style="margin-left:auto;gap:10px;display:flex;"><span class="leg"><span class="status-dot status-OK"></span>OK</span><span class="leg"><span class="status-dot status-FALTA"></span>Falta</span><span class="leg"><span class="status-dot status-ATESTADO"></span>Atest.</span><span class="leg"><span class="status-dot status-FOLGA"></span>Folga</span><span class="leg"><span class="status-dot status-EXTRA"></span>Extra</span></div>`;
    host.innerHTML=`
      <div class="hdr">
        <div>
          <div class="line-title" style="color:${line.color};">Linha ${line.num}</div>
          <div class="line-subtitle">${line.desc}</div>
        </div>
        <div class="month-nav">
          <button onclick="navMonth(-1)">‹</button>
          <span class="mn-label">${MONTHS_PT[currentMonth]} ${currentYear}</span>
          <button onclick="navMonth(1)">›</button>
        </div>
      </div>
      <div class="leg-bar">${legend}${statusLeg}</div>
      ${READ_ONLY?'':'<div class="hint">✦ toque em um horário para atribuir motorista · arraste para mover · ✦</div>'}
      <div class="cal-wrap"><div class="calendar" id="cal-grid"></div></div>
    `;
    const grid=document.getElementById('cal-grid');
    DAYS_PT.forEach((d,i)=>{const h=document.createElement('div');h.className='day-hdr'+(i===0?' dom':'');h.textContent=d;grid.appendChild(h);});
    const fd=new Date(currentYear,currentMonth,1).getDay();
    const dim=new Date(currentYear,currentMonth+1,0).getDate();
    const today=new Date();
    const isCurMonth=today.getFullYear()===currentYear&&today.getMonth()===currentMonth;
    for(let i=0;i<fd;i++){const e=document.createElement('div');e.className='cell empty';grid.appendChild(e);}
    for(let d=1;d<=dim;d++){
      const dow=new Date(currentYear,currentMonth,d).getDay();
      const cell=document.createElement('div');
      cell.className='cell'+(dow===0?' dom':'')+((dow===0||dow===6)?' weekend':'')+(isCurMonth&&today.getDate()===d?' today':'');
      cell.dataset.day=d;
      const numEl=document.createElement('div');numEl.className='day-num';numEl.textContent=d;cell.appendChild(numEl);
      const dowEl=document.createElement('div');dowEl.className='day-dow';dowEl.textContent=DAYS_PT[dow];cell.appendChild(dowEl);
      const hol=getHoliday(currentMonth,d);
      if(hol){const t=document.createElement('div');t.className='htag';t.textContent=hol;cell.appendChild(t);}
      // Render time slots
      const times=getTimesForDay(line,dow);
      times.forEach(time=>{
        const key=slotKey(currentLine,currentYear,currentMonth,d,time);
        const slot=schedule[key];
        const row=document.createElement('div');
        row.className='time-row'+(slot?'':' empty-slot');
        if(slot&&activeFilter!=='TODOS'&&slot.driver!==activeFilter)row.classList.add('dimmed');
        row.dataset.slotKey=key;row.dataset.time=time;row.dataset.day=d;
        const tag=document.createElement('div');tag.className='time-tag';tag.textContent=time;row.appendChild(tag);
        const chip=document.createElement('div');chip.className='driver-chip';
        if(slot){
          const drv=getDriver(slot.driver);
          chip.style.color=drv.color;
          const av=document.createElement('span');av.className='av';
          if(drv.photo){const img=document.createElement('img');img.src=drv.photo;av.appendChild(img);}
          else{av.style.background=drv.color;av.textContent='👤';}
          chip.appendChild(av);
          const nm=document.createElement('span');nm.className='nm';nm.textContent=slot.driver;chip.appendChild(nm);
          if(!READ_ONLY||slot.status==='OK'){
            const dot=document.createElement('span');dot.className='status-dot status-'+slot.status;row.appendChild(chip);row.appendChild(dot);
          }else{
            row.appendChild(chip);
          }
        }else{
          chip.innerHTML='<span style="font-size:14px;line-height:1;">+</span><span class="nm">atribuir</span>';
          row.appendChild(chip);
        }
        if(!READ_ONLY){
          setupSlotInteraction(row,key,time,d);
        }
        cell.appendChild(row);
      });
      const ct=comments[dayKey(currentYear,currentMonth,d)+'|'+currentLine];
      if(ct){
        const cb=document.createElement('div');cb.className='comment-bubble';
        cb.innerHTML=`<span class="cb-icon">💬</span><span class="cb-text">${escHtml(ct)}</span>`;
        if(!READ_ONLY)cb.onclick=()=>openCommentSheet(d);
        cell.appendChild(cb);
      }else if(!READ_ONLY){
        const acb=document.createElement('div');acb.className='add-btn';acb.style.fontSize='8px';acb.textContent='+ comentário';
        acb.onclick=e=>{e.stopPropagation();openCommentSheet(d);};cell.appendChild(acb);
      }
      grid.appendChild(cell);
    }
    const rem=grid.children.length%7;
    if(rem)for(let i=0;i<7-rem;i++){const e=document.createElement('div');e.className='cell empty';grid.appendChild(e);}
  }catch(err){
    console.error(err);
    document.getElementById('calendar-host').innerHTML=`<div style="padding:24px;color:#e05555;">Erro: ${err.message}</div>`;
  }
}

function navMonth(delta){
  currentMonth+=delta;
  if(currentMonth>11){currentMonth=0;currentYear++;}
  if(currentMonth<0){currentMonth=11;currentYear--;}
  renderAll();
}

