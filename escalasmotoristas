function markDirty(){isDirty=true;saveLocal();setSyncStatus('synced','Salvo localmente '+new Date().toLocaleTimeString('pt-BR'));}
function saveLocal(){try{localStorage.setItem('escala_motoristas_v1',JSON.stringify({lines,drivers,schedule,comments,savedAt:Date.now()}));}catch(e){}}
function loadLocal(){try{const raw=localStorage.getItem('escala_motoristas_v1');if(!raw)return;const p=JSON.parse(raw);if(p.lines&&p.lines.length)lines=p.lines;if(p.drivers&&p.drivers.length)drivers=p.drivers;if(p.schedule)schedule=p.schedule;if(p.comments)Object.assign(comments,p.comments);const d=new Date(p.savedAt);setSyncStatus('synced','Carregado '+d.toLocaleString('pt-BR'));}catch(e){setSyncStatus('error','Erro');}}

let toastT;
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),2600);}

// Init UI by role
function initRoleUI(){
  const tbr=document.getElementById('top-bar-right');
  if(ROLE==='view'){
    document.body.classList.add('light');
    if(tbr)tbr.innerHTML=`<div style="font-size:10px;color:var(--muted);padding:7px 14px;border:1px solid var(--border);border-radius:20px;">👁 Visualização</div><button onclick="toggleTheme()" style="font-family:'Georgia Pro','Georgia',serif;font-size:10px;padding:7px 12px;border-radius:20px;cursor:pointer;background:var(--surface);border:1px solid var(--border);color:var(--muted);">📴</button><button onclick="promptAdminLogin()" style="font-family:'Georgia Pro','Georgia',serif;font-size:10px;padding:7px 12px;border-radius:20px;cursor:pointer;background:rgba(212,168,67,.1);border:1px solid rgba(212,168,67,.3);color:var(--accent);">🔐 Entrar</button>`;
  } else if(ROLE==='assist'){
    // Hide admin-only buttons
    const lineBtn=document.getElementById('btn-lines');if(lineBtn)lineBtn.style.display='none';
    const drvBtn=document.getElementById('btn-drivers');if(drvBtn)drvBtn.style.display='none';
    const shBtn=document.getElementById('btn-share');if(shBtn)shBtn.style.display='none';
    // Update badge
    const badge=document.querySelector('.cloud-badge');
    if(badge)badge.innerHTML='🚌 Escala Macabu · <span style="color:#a99ef5;">Assistente</span>';
  } else if(ROLE==='admin'){
    const badge=document.querySelector('.cloud-badge');
    if(badge)badge.innerHTML='🚌 Escala Macabu · <span style="color:var(--accent);">Admin</span>';
  }
}

document.addEventListener('DOMContentLoaded',()=>{
  initRoleUI();
  loadLocal();
  renderAll();
  setSyncStatus('synced','Pronto · Modo '+(ROLE==='admin'?'Admin':ROLE==='assist'?'Assistente':'Visualização'));
});
</script>
