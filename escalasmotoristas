    fileInp.onchange=()=>{const f=fileInp.files[0];if(!f)return;const r=new FileReader();r.onload=e=>{const t=new Image();t.onload=()=>{const cv=document.createElement('canvas');const M=100;let w=t.width,h=t.height;if(w>h){if(w>M){h=Math.round(h*M/w);w=M;}}else{if(h>M){w=Math.round(w*M/h);h=M;}}cv.width=w;cv.height=h;cv.getContext('2d').drawImage(t,0,0,w,h);selPhoto=cv.toDataURL('image/jpeg',0.6);preview.innerHTML='';const pi=document.createElement('img');pi.src=selPhoto;pi.style.cssText='width:100%;height:100%;object-fit:cover;';preview.appendChild(pi);};t.src=e.target.result;};r.readAsDataURL(f);};
    wrap.appendChild(preview);wrap.appendChild(pickBtn);wrap.appendChild(fileInp);
    fgP.appendChild(lP);fgP.appendChild(wrap);body.appendChild(fgP);
    // Name
