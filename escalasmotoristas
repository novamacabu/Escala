function openSlotEdit(slotK,time,d){
  const existing=schedule[slotK];
  const line=getLine(currentLine);
  let selDriver=existing?existing.driver:null;
  let selStatus=existing?existing.status:'OK';
  openSheet(dayLabelFromNum(d),`Linha ${line.num} · ${time}`,body=>{
    // Driver
    const fg1=document.createElement('div');fg1.className='form-group';
    const l1=document.createElement('div');l1.className='form-label';l1.textContent='Motorista';
    const grid=document.createElement('div');grid.className='driver-grid';
    drivers.forEach(d=>{
      const opt=document.createElement('div');opt.className='driver-opt';opt.textContent=d.name;opt.style.color=d.color;
      if(d.name===selDriver){opt.style.borderColor=d.color;opt.style.background=d.color+'22';}
      opt.onclick=()=>{selDriver=d.name;grid.querySelectorAll('.driver-opt').forEach(o=>{o.style.borderColor='';o.style.background='';});opt.style.borderColor=d.color;opt.style.background=d.color+'22';};
      grid.appendChild(opt);
    });
    fg1.appendChild(l1);fg1.appendChild(grid);body.appendChild(fg1);
    // Status
    const fg2=document.createElement('div');fg2.className='form-group';
    const l2=document.createElement('div');l2.className='form-label';l2.textContent='Status';
    const sg=document.createElement('div');sg.className='status-grid';
    const statusOpts=[{v:'OK',l:'✓ Escalado',c:'var(--ok-light)'}];
    if(IS_ADMIN)statusOpts.push({v:'EXTRA',l:'⏰ Hora Extra',c:'#fbbf24',adminOnly:true});
    statusOpts.push({v:'FOLGA',l:'☕ Folga',c:'#80c8f0'},{v:'ATESTADO',l:'🏥 Atestado',c:'#f0a0d0'},{v:'FALTA',l:'✗ Falta',c:'var(--warn-light)'});
    statusOpts.forEach(s=>{
      const opt=document.createElement('div');opt.className='status-opt'+(s.v===selStatus?' sel':'');
      opt.style.color=s.c;
      if(s.v===selStatus){opt.style.borderColor=s.c;opt.style.background=s.c.startsWith('#')?s.c+'22':'rgba(212,168,67,.12)';}
      opt.textContent=s.l;
      opt.onclick=()=>{selStatus=s.v;sg.querySelectorAll('.status-opt').forEach(o=>{o.classList.remove('sel');o.style.borderColor='';o.style.background='';});opt.classList.add('sel');opt.style.borderColor=s.c;opt.style.background=s.c.startsWith('#')?s.c+'22':'rgba(212,168,67,.12)';};
      sg.appendChild(opt);
    });
    fg2.appendChild(l2);fg2.appendChild(sg);body.appendChild(fg2);
    // Save
    const btn=document.createElement('button');btn.className='confirm-btn';btn.textContent=existing?'Salvar':'Atribuir';
    btn.onclick=()=>{
      if(!selDriver){showToast('Selecione um motorista');return;}
      schedule[slotK]={driver:selDriver,status:selStatus};
      renderAll();closeSheet();markDirty();
      showToast(`${selDriver} → ${time}`);
    };
    body.appendChild(btn);
    if(existing){
      const rm=document.createElement('button');rm.className='cancel-btn';rm.textContent='🗑 Remover atribuição';rm.style.color='var(--warn-light)';
      rm.onclick=()=>{delete schedule[slotK];renderAll();closeSheet();markDirty();showToast('Removido');};
      body.appendChild(rm);
    }
    const cb=document.createElement('button');cb.className='cancel-btn';cb.textContent='Cancelar';cb.onclick=closeSheet;body.appendChild(cb);
  });
}

function openCommentSheet(d){
  const ck=dayKey(currentYear,currentMonth,d)+'|'+currentLine;
  const current=comments[ck]||'';
  openSheet(dayLabelFromNum(d),'Comentário',body=>{
    const fg=document.createElement('div');fg.className='form-group';
    const lbl=document.createElement('div');lbl.className='form-label';lbl.textContent='Anotação do dia';
    const ta=document.createElement('textarea');ta.className='text-input';ta.style.minHeight='90px';ta.value=current;ta.maxLength=300;
    fg.appendChild(lbl);fg.appendChild(ta);body.appendChild(fg);
    const sb=document.createElement('button');sb.className='confirm-btn';sb.textContent='Salvar';
    sb.onclick=()=>{const v=ta.value.trim();if(v)comments[ck]=v;else delete comments[ck];renderAll();closeSheet();markDirty();};
    body.appendChild(sb);
    if(current){
      const rb=document.createElement('button');rb.className='cancel-btn';rb.textContent='🗑 Remover';rb.style.color='var(--warn-light)';
      rb.onclick=()=>{delete comments[ck];renderAll();closeSheet();markDirty();};body.appendChild(rb);
    }
    setTimeout(()=>ta.focus(),320);
  });
}

